# Copy this file to .env (same folder) and fill in YOUR key. Never paste a key into your coding agent's chat.
# .env is ignored by git. Get a free Gemini key at https://aistudio.google.com/apikey

GEMINI_API_KEY=
# Optional: another Gemini model if you hit a quota (429). Default: gemini-flash-lite-latest
GEMINI_MODEL=

# To use ANOTHER OpenAI-compatible provider instead of Gemini, fill these three and leave the Gemini lines alone:
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Optional tuning
LLM_JSON_MODE=
LLM_TIMEOUT_SECONDS=
LLM_MAX_WAIT_SECONDS=
LLM_MIN_SECONDS_BETWEEN_CALLS=

# Optional: a trace viewer (extras/trace_export.py). Needs: pip install langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
